      "year": 2022,
      "transformations": "map 2 good, 3 failing, U/unknown unknown; derive country shares from validated unique bodies",
      "deduplicationRule": "retain first source row per non-empty euGroundWaterBodyCode; aggregate validated unique bodies by canonical country code"
    },
